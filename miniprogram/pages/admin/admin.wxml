<view class="admin-container">
  <nav-bar 
    title="Pawscars 管理后台" 
    subtitle="赛程控制与运维" 
    showMyNomination="{{false}}" 
    showBack="{{true}}" 
    showRules="{{false}}" 
  />

  <scroll-view scroll-y class="admin-scroll">
    <!-- 1. 活动当前阶段流转控制器 -->
    <view class="admin-section-card">
      <view class="section-title">⚙️ 活动阶段推进控制</view>
      <view class="phase-selector-grid">
        <button 
          class="phase-btn {{config.currentPhase === 'nominate' ? 'active-phase' : ''}}"
          bindtap="onChangePhase"
          data-phase="nominate"
        >
          1. 报名期
        </button>
        <button 
          class="phase-btn {{config.currentPhase === 'vote_initial' ? 'active-phase' : ''}}"
          bindtap="onChangePhase"
          data-phase="vote_initial"
        >
          2. 初选划屏
        </button>
        <button 
          class="phase-btn {{config.currentPhase === 'vote_match_8' ? 'active-phase' : ''}}"
          bindtap="onChangePhase"
          data-phase="vote_match_8"
        >
          3. 8进4淘汰赛
        </button>
        <button 
          class="phase-btn {{config.currentPhase === 'vote_match_4' ? 'active-phase' : ''}}"
          bindtap="onChangePhase"
          data-phase="vote_match_4"
        >
          4. 4强德比
        </button>
        <button 
          class="phase-btn {{config.currentPhase === 'awards' ? 'active-phase' : ''}}"
          bindtap="onChangePhase"
          data-phase="awards"
        >
          5. 颁奖盛典
        </button>
      </view>
      <view class="phase-tip">
        当前阶段：<text class="highlight-text">{{currentPhaseText}}</text>（切换至 8进4 或 4强德比 会自动根据赛制规则结算并生成固定对阵表）
      </view>
    </view>

    <!-- 2. 数据看板 -->
    <view class="admin-section-card">
      <view class="section-title">📊 赛事数据看板</view>
      <view class="metrics-row">
        <view class="metric-box">
          <text class="metric-val">{{totalEntries}}</text>
          <text class="metric-label">总报名数</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{totalInitialVotes}}</text>
          <text class="metric-label">初选人次</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{totalCongrats}}</text>
          <text class="metric-label">贺词留言数</text>
        </view>
      </view>

      <view class="cat-stat-list">
        <view wx:for="{{categoryStats}}" wx:key="id" class="cat-stat-item">
          <text class="cat-stat-name">{{item.name}}</text>
          <text class="cat-stat-badge">{{item.count}} 只参赛</text>
        </view>
      </view>
    </view>

    <!-- 3. 测试身份快捷切换器 (免微信环境全流程测试) -->
    <view class="admin-section-card">
      <view class="section-title">👤 模拟身份切换器</view>
      <view class="desc-text">当前登录ID：<text class="highlight-text">{{currentLdap || '未绑定'}}</text></view>
      <view class="quick-id-row">
        <button class="small-id-btn" bindtap="onSwitchId" data-id="JENNIFER">JENNIFER</button>
        <button class="small-id-btn" bindtap="onSwitchId" data-id="ZHANG">ZHANG</button>
        <button class="small-id-btn" bindtap="onSwitchId" data-id="ALICE">ALICE</button>
        <button class="small-id-btn" bindtap="onSwitchId" data-id="BOBBY">BOBBY</button>
        <button class="small-id-btn admin-badge-btn" bindtap="onSwitchId" data-id="LIMA0001">👑 LIMA0001</button>
        <button class="small-id-btn admin-badge-btn" bindtap="onSwitchId" data-id="privacy-by-design">👑 privacy-by-design</button>
      </view>
      <view class="unbind-action" bindtap="onUnbindCurrent">
        <text class="text-danger">⚠️ 解绑当前身份（测试首次进入流程）</text>
      </view>
    </view>

    <!-- 3.1 管理员名单公示 -->
    <view class="admin-section-card">
      <view class="section-title">👑 活动管理员团队</view>
      <view class="admin-tags-row">
        <text class="admin-tag-pill">👑 lima0001 (LIMA0001)</text>
        <text class="admin-tag-pill">👑 privacy-by-design</text>
        <text class="admin-tag-pill">👑 宫师姐 (ADMIN_GONG)</text>
      </view>
    </view>

    <!-- 4. 门类名称自定义 -->
    <view class="admin-section-card">
      <view class="section-title">🏷️ 自定义三大门类名称</view>
      <view wx:for="{{categories}}" wx:key="id" class="cat-edit-row">
        <text class="cat-edit-icon">{{item.icon}}</text>
        <input 
          class="cat-edit-input" 
          value="{{item.name}}" 
          data-id="{{item.id}}" 
          bindblur="onEditCategoryName"
        />
      </view>
    </view>

    <!-- 5. 违规条目软删除管理 -->
    <view class="admin-section-card">
      <view class="section-title">🛡️ 违规条目与留言管理</view>
      <view class="moderation-desc">如发现网图水印或违规内容，可点击软删除：</view>
      <view class="moderation-list">
        <view wx:for="{{entriesSample}}" wx:key="id" class="moderation-item">
          <text class="mod-name">{{item.petName}} ({{item.ownerLdap}})</text>
          <text class="mod-btn text-danger" bindtap="onDeleteEntry" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>

    <!-- 6. 数据重置 -->
    <view class="admin-section-card">
      <view class="section-title">🔄 数据重置</view>
      <view class="desc-text">将所有赛程、票数、参赛毛孩恢复至初始示范数据：</view>
      <button class="paw-btn paw-btn-outline reset-all-btn" bindtap="onResetAll">
        一键重置所有数据
      </button>
    </view>
  </scroll-view>
</view>
