<view class="admin-container">
  <nav-bar title="Pawscars 管理后台" subtitle="赛程控制与运维" showMyNomination="{{false}}" showRules="{{false}}" />

  <!-- 非管理员：无权限 -->
  <view wx:if="{{!allowed}}" class="no-permission">
    <text class="no-permission-icon">🔒</text>
    <text class="no-permission-title">仅限活动管理员访问</text>
    <button class="paw-btn paw-btn-primary" bindtap="onGoHome">返回首页</button>
  </view>

  <view wx:else class="admin-scroll">
    <!-- 1. 活动阶段推进 -->
    <view class="admin-section-card">
      <view class="section-title">⚙️ 活动阶段推进控制</view>
      <view class="phase-selector-grid">
        <button
          wx:for="{{phases}}"
          wx:key="key"
          class="phase-btn {{config.currentPhase === item.key ? 'active-phase' : ''}}"
          bindtap="onChangePhase"
          data-phase="{{item.key}}"
        >{{item.label}}</button>
      </view>
      <view class="phase-tip">推进阶段会自动结算上一阶段并生成固定对阵表；回退会清除之后阶段的对阵与投票。</view>
    </view>

    <!-- 2. 阶段截止时间 -->
    <view class="admin-section-card">
      <view class="section-title">⏰ 各阶段截止时间</view>
      <view class="desc-text">过了截止时间用户将无法继续报名/投票，但阶段需要由你手动推进。</view>
      <view wx:for="{{deadlineRows}}" wx:key="key" class="deadline-row">
        <text class="deadline-label">{{item.label}}</text>
        <picker mode="date" value="{{item.date}}" data-phase="{{item.key}}" data-part="date" bindchange="onDeadlineChange">
          <view class="picker-chip">{{item.date}}</view>
        </picker>
        <picker mode="time" value="{{item.time}}" data-phase="{{item.key}}" data-part="time" bindchange="onDeadlineChange">
          <view class="picker-chip">{{item.time}}</view>
        </picker>
      </view>
    </view>

    <!-- 3. 数据看板 -->
    <view class="admin-section-card">
      <view class="section-title">📊 赛事数据看板</view>
      <view class="metrics-row">
        <view class="metric-box">
          <text class="metric-val">{{stats.totalEntries}}</text>
          <text class="metric-label">有效报名</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{stats.totalVoters}}</text>
          <text class="metric-label">投票人数</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{stats.totalMatchVotes}}</text>
          <text class="metric-label">PK 票数</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{stats.totalCongrats}}</text>
          <text class="metric-label">贺词</text>
        </view>
      </view>
      <view class="cat-stat-list">
        <view wx:for="{{stats.perCategory}}" wx:key="id" class="cat-stat-item">
          <text class="cat-stat-name">{{item.name}}</text>
          <text class="cat-stat-detail">{{item.entryCount}} 只参赛 · 初选 {{item.initialVoterCount}} 人 · PK {{item.pkVoterCount}} 人</text>
        </view>
      </view>
    </view>

    <!-- 4. 活动信息文案 -->
    <view class="admin-section-card">
      <view class="section-title">📝 活动信息与文案</view>
      <view class="field-label">活动主标题</view>
      <input class="field-input" value="{{form.title}}" data-field="title" bindinput="onFormInput" maxlength="20" />
      <view class="field-label">主持人头像（首页发言人、规则气泡与证书使用）</view>
      <view class="avatar-row" bindtap="onChooseHostAvatar">
        <image wx:if="{{hostAvatar}}" class="host-avatar-preview" src="{{hostAvatar}}" mode="aspectFill" />
        <view wx:else class="host-avatar-preview avatar-empty">{{form.hostName[0] || '宫'}}</view>
        <text class="avatar-change">更换头像</text>
      </view>
      <view class="field-label">主持人昵称</view>
      <input class="field-input" value="{{form.hostName}}" data-field="hostName" bindinput="onFormInput" maxlength="10" />
      <view class="field-label">首页开场白</view>
      <textarea class="field-textarea" value="{{form.hostIntro}}" data-field="hostIntro" bindinput="onFormInput" maxlength="200" auto-height />
      <view class="field-label">赛制一句话</view>
      <input class="field-input" value="{{form.rulesSummary}}" data-field="rulesSummary" bindinput="onFormInput" maxlength="40" />
      <view class="field-label">结尾号召语</view>
      <input class="field-input" value="{{form.callToActionText}}" data-field="callToActionText" bindinput="onFormInput" maxlength="40" />
      <view class="field-label">比赛规则（投票页"比赛规则"弹窗）</view>
      <textarea class="field-textarea tall" value="{{form.rulesDetail}}" data-field="rulesDetail" bindinput="onFormInput" maxlength="2000" />
      <button class="paw-btn paw-btn-primary save-btn" bindtap="onSaveConfig">保存活动信息</button>
    </view>

    <!-- 5. 门类名称 -->
    <view class="admin-section-card">
      <view class="section-title">🏷️ 三大门类名称</view>
      <view wx:if="{{categoryLocked}}" class="desc-text">投票已开始，门类名称已锁定。</view>
      <view wx:for="{{categories}}" wx:key="id" class="cat-edit-row">
        <text class="cat-edit-icon">{{item.icon}}</text>
        <input class="cat-edit-input" value="{{item.name}}" data-id="{{item.id}}" bindblur="onEditCategoryName" disabled="{{categoryLocked}}" maxlength="10" />
      </view>
    </view>

    <!-- 6. 活动ID 申诉解绑 -->
    <view class="admin-section-card">
      <view class="section-title">🆔 活动ID 申诉处理</view>
      <view class="desc-text">线下核实申诉后，解绑被误占用的ID，让正确的人重新绑定。</view>
      <view class="unbind-row">
        <input class="field-input unbind-input" placeholder="输入要解绑的活动ID" value="{{unbindInput}}" bindinput="onUnbindInput" />
        <button class="paw-btn paw-btn-outline unbind-btn" bindtap="onUnbindLdap">解绑</button>
      </view>
    </view>

    <!-- 7. 违规内容处理 -->
    <view class="admin-section-card">
      <view class="section-title">🛡️ 违规报名与贺词</view>
      <view wx:for="{{moderationGroups}}" wx:key="id" wx:for-item="group" class="moderation-group">
        <view class="moderation-group-title">{{group.name}}（{{group.entries.length}}）</view>
        <view wx:for="{{group.entries}}" wx:key="id" class="moderation-item">
          <image class="mod-thumb" src="{{item.photoUrl}}" mode="aspectFill" />
          <text class="mod-name">{{item.petName}} · {{item.ownerLdap}}</text>
          <text class="mod-btn text-danger" bindtap="onDeleteEntry" data-id="{{item.id}}" data-name="{{item.petName}}">删除</text>
        </view>
      </view>
      <view class="moderation-group-title">贺词（{{congratsItems.length}}）</view>
      <view wx:for="{{congratsItems}}" wx:key="id" class="moderation-item">
        <text class="mod-name">{{item.content}} — {{item.ownerLdap}}</text>
        <text class="mod-btn text-danger" bindtap="onHideCongrats" data-id="{{item.id}}">隐藏</text>
      </view>
    </view>

    <!-- 8. 开发调试工具（仅开发版/体验版可见） -->
    <view wx:if="{{isDevBuild && isMockMode}}" class="admin-section-card dev-card">
      <view class="section-title">🧪 开发调试 · 本地模式（正式版不显示）</view>
      <view class="desc-text">当前本机身份：<text class="highlight-text">{{currentLdap || '未绑定'}}</text></view>
      <view class="quick-id-row">
        <button wx:for="{{devIds}}" wx:key="*this" class="small-id-btn" bindtap="onSwitchId" data-id="{{item}}">{{item}}</button>
      </view>
      <view class="unbind-action" bindtap="onUnbindCurrent">
        <text class="text-danger">解绑当前身份（测试首次进入流程）</text>
      </view>
      <button class="paw-btn paw-btn-outline reset-all-btn" bindtap="onResetAll">一键重置为演示数据</button>
    </view>
  </view>
</view>
