<view class="home-screen">
  <!-- 顶部 Banner 区 (浅粉背景 #FBEAF0) -->
  <view class="banner-area">
    <view class="cat-dog-row">
      <!-- 左：猫头装饰圈 (52px, powder blue背景) -->
      <view class="avatar-circle">
        <text class="pet-deco-emoji">🐱</text>
      </view>

      <!-- 中：活动主标题 -->
      <view class="title-wrap" bindtap="onTitleClick">
        <text class="brand-title">Pawscars</text>
        <text class="brand-subtitle">{{config.title || '毛孩奥斯卡'}}</text>
      </view>

      <!-- 右：狗头装饰圈 (52px, powder blue背景) -->
      <view class="avatar-circle">
        <text class="pet-deco-emoji">🐶</text>
      </view>
    </view>

    <!-- 下方：三个小图标圈 (30px，黄/绿/紫三色，爪子/奖杯/爱心) -->
    <view class="deco-icons-row">
      <view class="mini-icon-circle icon-yellow">🐾</view>
      <view class="mini-icon-circle icon-green">🏆</view>
      <view class="mini-icon-circle icon-purple">❤️</view>
    </view>
  </view>

  <!-- 正文内容区（严格适配一屏自适应排版要求） -->
  <view class="content-body">
    <!-- 主持人"发言人"样式开场：头像 + 昵称，紧跟阶段文案 -->
    <view class="spokesperson-row">
      <view class="gong-avatar">
        <image wx:if="{{hostAvatar}}" class="gong-avatar-img" src="{{hostAvatar}}" mode="aspectFill" binderror="onHostAvatarError" />
        <text wx:else class="gong-text">{{config.hostName[0] || '宫'}}</text>
      </view>
      <text class="gong-name">{{config.hostName || '宫师姐'}}</text>
    </view>

    <!-- 阶段A：报名期 -->
    <block wx:if="{{phaseKind === 'nominate'}}">
      <view class="story-desc">{{config.hostIntro}}</view>

      <view class="phase-strip {{phaseOpen ? '' : 'phase-strip-closed'}}">
        <text wx:if="{{phaseOpen && countdownText}}">报名中 · 距截止还剩 {{countdownText}}</text>
        <text wx:elif="{{phaseOpen}}">报名进行中</text>
        <text wx:else>报名已截止，初选即将开始</text>
      </view>

      <view class="rule-capsule-wrap">
        <view class="rule-capsule" bindtap="onShowRules">{{config.rulesSummary}} ›</view>
      </view>

      <view class="category-heading">评选类别：</view>
      <view class="category-cards-row">
        <view wx:for="{{categories}}" wx:key="id" class="cat-card cat-card-{{item.theme}}" style="background-color: {{item.bg}};">
          <view class="cat-card-icon">{{item.icon}}</view>
          <view class="cat-card-title" style="color: {{item.textColor}};">{{item.tag}}</view>
          <view class="cat-card-sub" style="color: {{item.textColor}};">{{item.suffix}}</view>
        </view>
      </view>

      <view class="cta-callout">{{config.callToActionText}}</view>

      <button class="paw-btn paw-btn-primary full-cta-btn {{phaseOpen ? '' : 'btn-disabled'}}" bindtap="onTapNominate">
        {{phaseOpen ? '我要提名' : '报名已截止'}}
      </button>
      <button wx:if="{{!phaseOpen}}" class="paw-btn paw-btn-outline full-cta-btn sec-btn top-gap" bindtap="onTapMyNomination">
        <text class="btn-icon">📋</text> 我的提名
      </button>
    </block>

    <!-- 阶段B：投票期（初选 / 8进4 / 4强德比） -->
    <block wx:elif="{{phaseKind === 'vote'}}">
      <view class="speech-bubble">
        <view class="status-stage-tag">投票进行中 · {{votePhaseInfo.step}}</view>
        <view class="status-main-title">Pawscars【{{votePhaseInfo.name}}】进行时</view>
        <view class="status-countdown">
          <text wx:if="{{!phaseOpen}}">本阶段投票已截止，结果即将公布</text>
          <text wx:elif="{{countdownText}}">距离本阶段投票截止还有 {{countdownText}}</text>
          <text wx:else>快来为喜欢的毛孩投上一票！</text>
        </view>
      </view>

      <view class="stage-stepper-row">
        <view class="step-pill {{config.currentPhase === 'vote_initial' ? 'pill-active' : ''}}">初选</view>
        <view class="step-pill {{config.currentPhase === 'vote_match_8' ? 'pill-active' : ''}}">8进4</view>
        <view class="step-pill {{config.currentPhase === 'vote_match_4' ? 'pill-active' : ''}}">4强德比</view>
      </view>

      <view class="voting-action-group">
        <button class="paw-btn paw-btn-primary full-cta-btn {{phaseOpen ? '' : 'btn-disabled'}}" bindtap="onTapVote">
          {{phaseOpen ? '我要投票' : '投票已截止'}}
        </button>
        <button class="paw-btn paw-btn-outline full-cta-btn sec-btn" bindtap="onTapMyNomination">
          <text class="btn-icon">📋</text> 我的提名
        </button>
      </view>
    </block>

    <!-- 阶段C：颁奖期 -->
    <block wx:else>
      <view class="speech-bubble speech-bubble-gold">
        <view class="awards-banner-icon">🏆</view>
        <view class="awards-congrats-text">热烈祝贺 {{awardsYear}} {{config.title}}的王者们！</view>
        <view class="awards-sub-text">各大门类冠亚季军已荣耀揭晓，来贺词墙送上祝福吧</view>
      </view>

      <view class="voting-action-group">
        <button class="paw-btn paw-btn-primary full-cta-btn" bindtap="onTapSendCongrats">发送贺词</button>
        <button class="paw-btn paw-btn-outline full-cta-btn sec-btn" bindtap="onTapAwards">
          <text class="btn-icon">🏆</text> 查看颁奖结果
        </button>
        <button class="paw-btn paw-btn-outline full-cta-btn sec-btn" bindtap="onTapMyNomination">
          <text class="btn-icon">📋</text> 我的提名
        </button>
      </view>
    </block>
  </view>

  <!-- 底部管理后台便捷入口 -->
  <view wx:if="{{canAccessAdmin}}" class="admin-link-row">
    <text class="admin-link-text" bindtap="onTapAdmin">⚙️ 管理后台</text>
  </view>

  <!-- 规则弹窗组件 -->
  <rules-modal visible="{{rulesModalVisible}}" bind:close="onCloseRules" />
</view>
