.my-nom-container {
  min-height: 100vh;
  background-color: #FDFBF7;
  display: flex;
  flex-direction: column;
}

.nom-scroll {
  flex: 1;
  padding: 16px 20px 30px;
  box-sizing: border-box;
}

.user-header-card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 16px;
  display: flex;
  align-items: center;
  margin-bottom: 16px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
}

.user-avatar-tag {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #FBEAF0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-right: 12px;
}

.user-info {
  flex: 1;
}

.user-ldap-title {
  font-size: 15px;
  font-weight: 700;
  color: #2B2625;
  display: block;
}

.user-sub {
  font-size: 11px;
  color: #8C8482;
  margin-top: 2px;
  display: block;
}

.entries-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.nom-entry-card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 14px;
  display: flex;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
}

.entry-left {
  margin-right: 14px;
}

.entry-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.entry-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pet-title {
  font-size: 16px;
  font-weight: 700;
  color: #2B2625;
}

.cat-pill {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 10px;
}

.status-box {
  margin-top: 8px;
  background: #FAF8F2;
  border-radius: 12px;
  padding: 8px 10px;
}

.status-pill {
  font-size: 12px;
  font-weight: 700;
  color: #D85A30;
  margin-bottom: 2px;
}

.status-desc {
  font-size: 11px;
  color: #6E6765;
  line-height: 1.4;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60px 20px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-title {
  font-size: 16px;
  font-weight: 700;
  color: #38242A;
  margin-bottom: 6px;
}

.empty-sub {
  font-size: 12px;
  color: #8C8482;
  margin-bottom: 20px;
}

.empty-btn {
  width: 180px;
  height: 42px;
  font-size: 14px;
}
