<view class="initial-vote-container">
  <!-- 顶部三段式导航条 -->
  <nav-bar
    title="Pawscars毛孩奥斯卡"
    subtitle="初选投票"
    showMyNomination="{{true}}"
    showRules="{{true}}"
    bind:openRules="onOpenRules"
  />

  <view wx:if="{{!phaseOpen}}" class="closed-banner">初选投票已截止，已提交的选择仍可在下方查看</view>

  <!-- 正文区：三门类同页分行展示 -->
  <view class="vote-rows">
    <view class="category-row-section" wx:for="{{categoryList}}" wx:key="id" wx:for-item="cat">
      <!-- 门类行头：名称 + 状态/计数 -->
      <view class="row-header">
        <text class="row-cat-name" style="color: {{cat.textColor}};">{{cat.icon}} {{cat.name}}</text>
        <view wx:if="{{!cat.needsVote}}" class="row-status-pill">免初选</view>
        <view wx:elif="{{cat.isLocked}}" class="row-status-pill pill-locked">已提交 ✓</view>
        <view wx:else class="row-counter-badge">
          已选 <text class="counter-num">{{cat.selectedIds.length}}</text>/8
        </view>
      </view>

      <!-- 报名不足 9 位：全员直接晋级，无需初选（照片照常展示，只是不能选择） -->
      <view wx:if="{{!cat.needsVote}}" class="skip-note" style="background-color: {{cat.bg}}; color: {{cat.textColor}};">
        {{cat.entries.length === 8 ? '角逐提名毛孩正好8名' : '本项角逐提名毛孩不足8名'}}，全员晋级淘汰赛。恭喜各位毛孩晋级！
      </view>

      <!-- 横向滑动区：中间当前照片，左右露出前后照片边缘 -->
      <block wx:if="{{cat.entries.length}}">
        <swiper
          class="pet-swiper"
          current="{{cat.currentIndex}}"
          previous-margin="120rpx"
          next-margin="120rpx"
          bindchange="onSwiperChange"
          data-catid="{{cat.id}}"
        >
          <swiper-item wx:for="{{cat.entries}}" wx:key="id" wx:for-item="pet" class="swiper-pet-item">
            <view class="card-outer-wrap">
              <view class="pet-name-top">{{pet.petName}}</view>
              <view
                class="main-pet-card {{cat.selectedMap[pet.id] ? 'card-selected' : ''}} {{index === cat.currentIndex ? '' : 'card-side'}} {{cat.needsVote ? '' : 'card-readonly'}}"
                style="background-color: {{cat.bg}};"
                bindtap="onToggleSelect"
                data-catid="{{cat.id}}"
                data-petid="{{pet.id}}"
              >
                <image class="card-pet-img" src="{{pet.photoUrl}}" mode="aspectFill" lazy-load />
                <!-- 右上角心形：空心=未选，实心红=已选 -->
                <view wx:if="{{cat.needsVote}}" class="heart-badge-btn">
                  <text class="heart-icon">{{cat.selectedMap[pet.id] ? '❤️' : '🤍'}}</text>
                </view>
                <view class="watermark-overlay">主人 {{pet.maskedLdap}}</view>
              </view>
            </view>
          </swiper-item>
        </swiper>
        <view class="position-hint">第 {{cat.currentIndex + 1}} / {{cat.entries.length}} 位 · 左右滑动浏览{{cat.needsVote ? '，点击照片选择' : ''}}</view>
      </block>
    </view>
  </view>

  <!-- 底部吸底提交按钮 -->
  <view wx:if="{{phaseOpen}}" class="bottom-bar">
    <view wx:if="{{allSubmitted}}" class="done-bar">
      <text class="done-text">✅ 初选已全部提交，等待 8 强揭晓</text>
      <button class="paw-btn paw-btn-outline submit-vote-btn" bindtap="onGoMyNominations">查看我的提名</button>
    </view>
    <button wx:else class="paw-btn paw-btn-primary submit-vote-btn" bindtap="onOpenConfirm">选好了！冲鸭</button>
  </view>

  <!-- 提交确认页：分门类展示已选缩略图 -->
  <view wx:if="{{confirmVisible}}" class="confirm-mask" catchtouchmove="noop">
    <view class="confirm-sheet">
      <view class="confirm-title">确认提交初选</view>
      <view class="confirm-sub">每个门类提交后即锁定，不可更改</view>
      <scroll-view scroll-y class="confirm-body">
        <view wx:for="{{pendingGroups}}" wx:key="id" wx:for-item="group" class="confirm-group">
          <view class="confirm-group-title" style="color: {{group.textColor}};">{{group.name}} · {{group.picks.length}} 张</view>
          <view class="thumb-row">
            <view wx:for="{{group.picks}}" wx:key="id" class="thumb">
              <image class="thumb-img" src="{{item.photoUrl}}" mode="aspectFill" />
              <text class="thumb-name">{{item.petName}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="confirm-actions">
        <button class="paw-btn paw-btn-outline confirm-btn" bindtap="onCloseConfirm">返回修改</button>
        <button class="paw-btn paw-btn-primary confirm-btn" bindtap="onSubmitInitialVotes" loading="{{submitting}}">确认提交</button>
      </view>
    </view>
  </view>

  <!-- 投票成功弹窗（自定义，可显示平面风庆祝图标） -->
  <view wx:if="{{successVisible}}" class="success-mask" catchtouchmove="noop">
    <view class="success-card">
      <image class="success-icon" src="/images/icon-party.png" mode="aspectFit" />
      <view class="success-title">投票成功！</view>
      <view class="success-desc">已提交 {{successCount}} 个门类的初选投票，初选截止后将按票数产生 8 强。</view>
      <view class="confirm-actions">
        <button class="paw-btn paw-btn-outline confirm-btn" bindtap="onCloseSuccess">留在本页</button>
        <button class="paw-btn paw-btn-primary confirm-btn" bindtap="onSuccessGoMine">我的提名</button>
      </view>
    </view>
  </view>

  <!-- 比赛规则弹窗 -->
  <rules-modal visible="{{rulesModalVisible}}" bind:close="onCloseRules" />
</view>
