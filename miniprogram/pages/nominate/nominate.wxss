.nominate-container {
  min-height: 100vh;
  background-color: #FDFBF7;
  display: flex;
  flex-direction: column;
}

.form-scroll {
  flex: 1;
  padding: 16px 20px 30px;
  box-sizing: border-box;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24px;
  padding: 20px 18px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 20px;
}

.item-label {
  display: flex;
  align-items: baseline;
  margin-bottom: 8px;
}

.label-title {
  font-size: 13px;
  font-weight: 600;
  color: #332827;
}

.label-required {
  color: #E56B6F;
  margin-left: 2px;
}

.label-hint {
  font-size: 11px;
  color: #8C8482;
  margin-left: 4px;
}

/* 照片上传框：正方形，圆角 16px */
.photo-upload-box {
  width: 200px;
  height: 200px;
  margin: 0 auto;
  background: #FAF8F2;
  border: 2px dashed #E0DACD;
  border-radius: 18px;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.change-photo-badge {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 12px;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.camera-icon {
  font-size: 36px;
  margin-bottom: 6px;
}

.upload-tip {
  font-size: 13px;
  font-weight: 600;
  color: #554845;
}

.upload-sub {
  font-size: 11px;
  color: #9C9391;
  margin-top: 2px;
}

.name-input {
  height: 44px;
  background: #F7F5F0;
  border: 1.5px solid #EBE6DC;
  border-radius: 14px;
  padding: 0 14px;
  font-size: 13px;
  color: #2B2625;
}

/* 门类 chips 多选样式 */
.category-chips-wrap {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.cat-chip {
  padding: 10px 14px;
  border-radius: 16px;
  background: #F7F5F0;
  border: 1.5px solid #EBE6DC;
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.chip-active {
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
}

.chip-icon {
  font-size: 18px;
  margin-right: 8px;
}

.chip-name {
  font-size: 13px;
  font-weight: 600;
  flex: 1;
}

.check-icon {
  font-size: 14px;
  font-weight: bold;
}

/* 承诺勾选框 */
.pledge-item {
  display: flex;
  align-items: center;
  margin-top: 14px;
  margin-bottom: 20px;
}

.checkbox-circle {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #C4BCB8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex-shrink: 0;
}

.checkbox-circle.checked {
  background-color: #FAC775;
  border-color: #5C4A02;
}

.check-tick {
  font-size: 12px;
  font-weight: bold;
  color: #5C4A02;
}

.pledge-text {
  font-size: 12px;
  color: #554A49;
  line-height: 1.4;
}

.submit-wrap {
  margin-top: 10px;
}

.full-submit-btn {
  width: 100%;
  height: 44px;
  font-size: 15px;
}

/* 底部已提名条目预览 */
.my-entries-section {
  margin-top: 24px;
}

.section-heading {
  font-size: 13px;
  font-weight: 600;
  color: #38242A;
  margin-bottom: 10px;
}

.entries-grid {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.my-entry-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.entry-meta {
  margin-top: 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entry-date {
  font-size: 9px;
  color: var(--text-muted);
  margin-top: 2px;
}

.closed-notice {
  background: #F1EFE8;
  border-radius: 18px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.closed-title {
  font-size: 15px;
  font-weight: 700;
  color: #38242A;
}

.closed-desc {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.entry-group {
  margin-bottom: 12px;
}

.entry-group-title {
  display: flex;
  align-items: center;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 8px;
}

.group-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 6px;
}

.entry-edit-btn {
  margin-top: 4px;
  font-size: 11px;
  font-weight: 600;
  color: #993C1D;
  padding: 2px 8px;
  border-radius: 10px;
  background: #FBEAF0;
}
