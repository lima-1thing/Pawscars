.awards-page-container {
  min-height: 100vh;
  background-color: #FDFBF7;
}

.awards-body {
  padding: 12px 16px calc(40px + env(safe-area-inset-bottom));
}

.preview-banner {
  font-size: 11px;
  color: #7A2E4A;
  background: #FBEAF0;
  border-radius: 10px;
  padding: 6px 10px;
  text-align: center;
  margin-bottom: 10px;
}

/* 颁奖前占位 */
.not-started-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80px 32px;
}

.not-started-icon {
  font-size: 44px;
}

.not-started-title {
  font-size: 16px;
  font-weight: 700;
  color: #2B2625;
  margin-top: 12px;
}

.not-started-desc {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 6px;
  line-height: 1.6;
}

/* 红毯领奖区：酒红渐变 + 金色点缀，营造颁奖典礼仪式感 */
.red-carpet {
  background: linear-gradient(180deg, #5A1430 0%, #8E2446 55%, #B8325A 100%);
  border-radius: 24px;
  padding: 14px 10px 0;
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(90, 20, 48, 0.25);
}

.cat-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.cat-tabs-row {
  display: flex;
  gap: 8px;
  justify-content: center;
  padding: 0 4px 4px;
}

.tab-pill {
  flex-shrink: 0;
  padding: 6px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.14);
  color: #F8E6EC;
  font-size: 12px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-pill-active {
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.podium-empty {
  padding: 56px 0 64px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #F8E6EC;
}

/* 领奖台 */
.podium-stage {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6px;
  padding-top: 18px;
}

.podium-slot {
  flex: 1;
  max-width: 108px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trophy-badge, .medal-badge {
  font-size: 22px;
  margin-bottom: 4px;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
}

.trophy-badge {
  font-size: 30px;
}

.podium-card {
  border-radius: 18px;
  overflow: hidden;
  background: #FFFDF8;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}

.card-gold {
  width: 88px;
  height: 88px;
  border: 3px solid #F5C94C;
}

.card-silver {
  width: 64px;
  height: 64px;
  border: 2px solid #D5DBE2;
}

.card-bronze {
  width: 58px;
  height: 58px;
  border: 2px solid #D99A62;
}

.podium-pet-photo {
  width: 100%;
  height: 100%;
}

.pet-name {
  font-size: 13px;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 6px;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.champion-name {
  font-size: 15px;
  color: #FFE7A3;
}

.owner-mask {
  font-size: 10px;
  color: #F3CFDA;
  letter-spacing: 0.5px;
}

.score-text {
  font-size: 10px;
  font-weight: 600;
  color: #FFE7A3;
  margin-top: 2px;
  min-height: 14px;
}

/* 台阶：高低错落模拟真实颁奖台 */
.podium-step {
  width: 100%;
  margin-top: 8px;
  border-radius: 10px 10px 0 0;
  display: flex;
  justify-content: center;
  padding-top: 6px;
  font-size: 18px;
  font-weight: 800;
  box-sizing: border-box;
}

.step-gold {
  height: 64px;
  background: linear-gradient(180deg, #F9DC7C, #E5B53A);
  color: #6B4B00;
}

.step-silver {
  height: 44px;
  background: linear-gradient(180deg, #EEF1F5, #C9D0D9);
  color: #4F5864;
}

.step-bronze {
  height: 32px;
  background: linear-gradient(180deg, #F2C9A2, #D39462);
  color: #6E3F1A;
}

.award-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
}

.full-cert-btn {
  width: 100%;
  max-width: 320px;
  height: 44px;
  font-size: 14px;
}

.cert-hint {
  font-size: 11px;
  color: var(--text-muted);
}

.wall-empty {
  font-size: 12px;
  color: var(--text-muted);
  text-align: center;
  padding: 16px 0;
}

.sent-tip {
  font-size: 12px;
  font-weight: 600;
  color: #085041;
}

.awards-divider {
  width: 100%;
  height: 1px;
  background: #ECE7DE;
  margin: 16px 0 20px;
}

/* 贺词墙 */
.congrats-wall-section {
  display: flex;
  flex-direction: column;
}

.wall-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12px;
}

.wall-title {
  font-size: 15px;
  font-weight: 700;
  color: #2B2625;
}

.wall-count {
  font-size: 12px;
  color: var(--text-secondary);
  margin-left: 6px;
}

.wall-rule-tip {
  font-size: 11px;
  color: var(--text-muted);
}

.congrats-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 16px;
}

.congrats-card {
  background: #F4F2EC;
  border-radius: 14px;
  padding: 12px 14px;
}

.congrats-content {
  font-size: 13px;
  color: #38242A;
  line-height: 1.5;
  margin-bottom: 6px;
}

.congrats-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.congrats-sender {
  font-size: 10px;
  font-weight: 600;
  color: #7A7270;
}

.congrats-time {
  font-size: 9px;
  color: #B5ACA9;
}

.send-congrats-wrap {
  display: flex;
  justify-content: center;
}

.send-congrats-btn {
  width: 100%;
  max-width: 300px;
  height: 40px;
}

/* 发送贺词弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.send-modal-card {
  width: 100%;
  max-width: 320px;
  background: #FFFFFF;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.send-modal-title {
  font-size: 15px;
  font-weight: 700;
  color: #38242A;
  text-align: center;
  margin-bottom: 12px;
}

.congrats-textarea {
  width: 100%;
  height: 80px;
  background: #F7F5F0;
  border: 1px solid #EBE6DC;
  border-radius: 12px;
  padding: 10px;
  font-size: 13px;
  box-sizing: border-box;
}

.text-length-hint {
  font-size: 10px;
  color: var(--text-muted);
  text-align: right;
  margin-top: 4px;
  margin-bottom: 14px;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.half-btn {
  flex: 1;
  height: 40px;
  font-size: 13px;
}
