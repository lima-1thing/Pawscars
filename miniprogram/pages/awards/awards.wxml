<view class="awards-page-container">
  <!-- 顶部三段式导航条 -->
  <nav-bar
    title="Pawscars毛孩奥斯卡"
    subtitle="颁奖结果"
    showMyNomination="{{true}}"
    showRules="{{true}}"
    bind:openRules="onOpenRules"
  />

  <!-- 颁奖前：普通用户看不到结果 -->
  <view wx:if="{{!isAwardsPhase && !canPreview}}" class="not-started-box">
    <text class="not-started-icon">🎬</text>
    <text class="not-started-title">颁奖典礼尚未开始</text>
    <text class="not-started-desc">所有投票结束后将在这里揭晓各门类冠亚季军，敬请期待！</text>
  </view>

  <view wx:else class="awards-body">
    <view wx:if="{{!isAwardsPhase}}" class="preview-banner">管理员预览 · 普通用户在颁奖阶段开始后才能看到</view>

    <!-- 红毯领奖区 -->
    <view class="red-carpet">
      <!-- 门类横向胶囊切换标签 -->
      <scroll-view scroll-x class="cat-tabs-scroll" enable-flex>
        <view class="cat-tabs-row">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="tab-pill {{currentCategory.id === item.id ? 'tab-pill-active' : ''}}"
            style="{{currentCategory.id === item.id ? 'background-color:' + item.bg + '; color:' + item.textColor : ''}}"
            bindtap="onSelectCategory"
            data-id="{{item.id}}"
          >
            {{item.icon}} {{item.name}}
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{resultState === 'empty'}}" class="podium-empty">本门类无人参赛</view>
      <view wx:elif="{{resultState === 'pending'}}" class="podium-empty">结果将在 4 强德比结束后生成</view>
      <view wx:elif="{{resultState === 'loading'}}" class="podium-empty">结果加载中…</view>

      <!-- 领奖台：亚军（左）— 冠军（中，最大且最高）— 季军（右） -->
      <view wx:else class="podium-stage">
        <view class="podium-slot slot-silver">
          <block wx:if="{{awardsResult.runnerUp}}">
            <view class="medal-badge">🥈</view>
            <view class="podium-card card-silver" bindtap="onTapWinner" data-rank="runnerUp">
              <image class="podium-pet-photo" src="{{awardsResult.runnerUp.photoUrl}}" mode="aspectFill" />
            </view>
            <text class="pet-name">{{awardsResult.runnerUp.petName}}</text>
            <text class="owner-mask">主人 {{awardsResult.runnerUp.maskedLdap}}</text>
            <text class="score-text">{{awardsResult.runnerUp.scoreText}}</text>
          </block>
          <view class="podium-step step-silver"><text>2</text></view>
        </view>

        <view class="podium-slot slot-gold">
          <view class="trophy-badge">🏆</view>
          <view class="podium-card card-gold" bindtap="onTapWinner" data-rank="champion">
            <image class="podium-pet-photo" src="{{awardsResult.champion.photoUrl}}" mode="aspectFill" />
          </view>
          <text class="pet-name champion-name">{{awardsResult.champion.petName}}</text>
          <text class="owner-mask">主人 {{awardsResult.champion.maskedLdap}}</text>
          <text class="score-text">{{awardsResult.champion.scoreText}}</text>
          <view class="podium-step step-gold"><text>1</text></view>
        </view>

        <view class="podium-slot slot-bronze">
          <block wx:if="{{awardsResult.thirdPlace}}">
            <view class="medal-badge">🥉</view>
            <view class="podium-card card-bronze" bindtap="onTapWinner" data-rank="thirdPlace">
              <image class="podium-pet-photo" src="{{awardsResult.thirdPlace.photoUrl}}" mode="aspectFill" />
            </view>
            <text class="pet-name">{{awardsResult.thirdPlace.petName}}</text>
            <text class="owner-mask">主人 {{awardsResult.thirdPlace.maskedLdap}}</text>
            <text class="score-text">{{awardsResult.thirdPlace.scoreText}}</text>
          </block>
          <view class="podium-step step-bronze"><text>3</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{resultState === 'ready'}}" class="award-actions">
      <button class="paw-btn paw-btn-primary full-cert-btn" bindtap="onChooseCert">生成获奖证书</button>
      <button class="paw-btn paw-btn-outline full-cert-btn" open-type="share">📣 分享战报</button>
      <text class="cert-hint">也可以直接点击领奖台上的毛孩生成证书</text>
    </view>

    <view class="awards-divider"></view>

    <!-- 贺词墙（全局共用，不按门类拆分） -->
    <view id="congrats-wall" class="congrats-wall-section">
      <view class="wall-header">
        <view class="wall-title-box">
          <text class="wall-title">贺词墙</text>
          <text class="wall-count">({{congratsList.length}}条祝贺)</text>
        </view>
        <view class="wall-rule-tip">每人限发1条祝福</view>
      </view>

      <view wx:if="{{congratsList.length === 0}}" class="wall-empty">还没有人留言，来当第一个送祝福的人吧！</view>
      <view class="congrats-list">
        <view wx:for="{{congratsList}}" wx:key="id" class="congrats-card">
          <view class="congrats-content">{{item.content}}</view>
          <view class="congrats-meta">
            <text class="congrats-sender">{{item.maskedLdap}}</text>
            <text class="congrats-time">{{item.timeStr}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{isAwardsPhase}}" class="send-congrats-wrap">
        <button wx:if="{{!hasSentCongrats}}" class="paw-btn paw-btn-outline send-congrats-btn" bindtap="onOpenSendModal">✍️ 发送贺词</button>
        <text wx:else class="sent-tip">你的祝福已上墙 ✓</text>
      </view>
    </view>
  </view>

  <!-- 获奖证书弹窗 -->
  <cert-modal
    visible="{{certModalVisible}}"
    entry="{{certEntry}}"
    categoryName="{{currentCategory.name}}"
    rankText="{{certRankText}}"
    bind:close="onCloseCert"
  />

  <!-- 发送贺词弹窗 -->
  <view wx:if="{{sendModalVisible}}" class="modal-mask">
    <view class="send-modal-card">
      <view class="send-modal-title">为王者毛孩送上祝贺</view>
      <textarea
        class="congrats-textarea"
        placeholder="写下你对毛孩们的祝福（限50字以内）"
        value="{{myCongratsText}}"
        bindinput="onInputCongrats"
        maxlength="50"
        focus
      />
      <view class="text-length-hint">{{myCongratsText.length}}/50</view>
      <view class="modal-btn-row">
        <button class="paw-btn paw-btn-outline half-btn" bindtap="onCloseSendModal">取消</button>
        <button class="paw-btn paw-btn-primary half-btn" bindtap="onSubmitCongrats">发送祝福</button>
      </view>
    </view>
  </view>

  <rules-modal visible="{{rulesModalVisible}}" bind:close="onCloseRules" />
</view>
