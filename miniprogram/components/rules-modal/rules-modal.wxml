<view wx:if="{{visible}}" class="modal-overlay" catchtouchmove="preventD">
  <view class="modal-card">
    <view class="modal-header">
      <view class="host-avatar-badge">
        <image wx:if="{{hostAvatar}}" class="host-avatar-img" src="{{hostAvatar}}" mode="aspectFill" binderror="onAvatarError" />
        <text wx:else class="avatar-text">{{hostName[0]}}</text>
      </view>
      <view class="header-info">
        <text class="host-name">{{hostName}}发言</text>
        <text class="modal-title">Pawscars 比赛规则说明</text>
      </view>
      <view class="close-btn" bindtap="onClose">×</view>
    </view>
    
    <scroll-view scroll-y class="modal-body">
      <text class="section-text rules-detail" user-select>{{rulesDetail}}</text>
    </scroll-view>

    <view class="modal-footer">
      <button class="paw-btn paw-btn-primary full-btn" bindtap="onClose">我知道啦！继续比赛</button>
    </view>
  </view>
</view>
