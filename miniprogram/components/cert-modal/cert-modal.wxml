<view wx:if="{{visible}}" class="cert-overlay" catchtouchmove="preventD">
  <view class="cert-dialog">
    <!-- 预览即为导出的证书图片，长按可调出微信原生保存/转发菜单 -->
    <view class="cert-preview">
      <image wx:if="{{certPath}}" class="cert-image" src="{{certPath}}" mode="widthFix" show-menu-by-longpress />
      <view wx:elif="{{failed}}" class="cert-placeholder">
        <text>证书生成失败</text>
        <text class="retry-link" bindtap="onRetry">点击重试</text>
      </view>
      <view wx:else class="cert-placeholder">
        <text>证书生成中…</text>
      </view>
    </view>

    <view class="cert-actions">
      <button class="paw-btn paw-btn-primary action-btn" bindtap="onSaveImage" disabled="{{!certPath}}">保存到相册</button>
      <button class="paw-btn paw-btn-outline action-btn" bindtap="onShareImage" disabled="{{!certPath}}">分享证书</button>
    </view>
    <view class="close-link" bindtap="onClose">关闭</view>
  </view>

  <!-- 离屏画布：用于绘制证书 -->
  <canvas type="2d" id="certCanvas" class="cert-canvas"></canvas>
</view>
