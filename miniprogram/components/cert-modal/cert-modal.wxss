.cert-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
  box-sizing: border-box;
}

.cert-dialog {
  width: 100%;
  max-width: 300px;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: popCert 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popCert {
  from { transform: scale(0.85); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.cert-preview {
  width: 100%;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3);
  background: #FFFDF8;
}

.cert-image {
  width: 100%;
  display: block;
}

.cert-placeholder {
  height: 420px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text-secondary);
}

.retry-link {
  color: #993C1D;
  font-weight: 600;
}

.cert-actions {
  width: 100%;
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.action-btn {
  flex: 1;
  height: 40px;
  font-size: 13px;
}

.close-link {
  margin-top: 12px;
  font-size: 13px;
  color: #FFFFFF;
  padding: 4px 16px;
}

/* 画布放在视口外，只用于绘制导出 */
.cert-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 420px;
}
