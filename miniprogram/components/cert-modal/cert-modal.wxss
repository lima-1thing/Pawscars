.cert-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
  box-sizing: border-box;
}

.cert-dialog {
  width: 100%;
  max-width: 330px;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: popCert 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popCert {
  from { transform: scale(0.85); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.cert-poster {
  width: 100%;
  background: #FFFDF9;
  border-radius: 20px;
  padding: 12px;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}

.cert-border-outer {
  border: 2px solid #E5C378;
  border-radius: 14px;
  padding: 4px;
}

.cert-border-inner {
  border: 1px dashed #D4AF37;
  border-radius: 10px;
  padding: 16px 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: radial-gradient(circle at center, #FFFDF8 0%, #FAF5EA 100%);
}

.oscar-laurel {
  font-size: 28px;
  margin-bottom: 2px;
}

.cert-event-title {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 2px;
  color: #7A5816;
  text-transform: uppercase;
}

.cert-event-subtitle {
  font-size: 10px;
  color: #A0782C;
  margin-bottom: 12px;
  letter-spacing: 1px;
}

.cert-avatar-frame {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 3px solid #E5C378;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4px 10px rgba(122, 88, 22, 0.2);
  margin-bottom: 8px;
}

.cert-pet-photo {
  width: 100%;
  height: 100%;
}

.cert-badge-overlay {
  position: absolute;
  bottom: 2px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.6);
  color: #FFF;
  font-size: 8px;
  padding: 1px 6px;
  border-radius: 4px;
}

.cert-pet-name {
  font-size: 18px;
  font-weight: 700;
  color: #38242A;
  margin-bottom: 6px;
}

.cert-award-ribbon {
  background: linear-gradient(135deg, #FDE68A 0%, #F59E0B 100%);
  padding: 4px 14px;
  border-radius: 16px;
  margin-bottom: 10px;
  box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
}

.ribbon-text {
  font-size: 12px;
  font-weight: 700;
  color: #451A03;
  letter-spacing: 0.5px;
}

.cert-declaration {
  font-size: 10px;
  color: #635C5B;
  line-height: 1.5;
  margin-bottom: 14px;
  padding: 0 10px;
}

.cert-footer {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 8px;
  border-top: 1px solid #EADDC2;
}

.footer-sign {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.sign-title {
  font-size: 8px;
  color: #A0782C;
}

.sign-name {
  font-size: 10px;
  font-weight: 600;
  color: #5C4318;
}

.footer-seal {
  display: flex;
  align-items: center;
}

.seal-icon {
  font-size: 14px;
  margin-right: 2px;
}

.seal-text {
  font-size: 9px;
  font-weight: bold;
  color: #D97706;
}

.cert-actions {
  width: 100%;
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.action-btn {
  flex: 1;
  height: 40px;
  font-size: 13px;
}
