.cropper-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(20, 16, 16, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.cropper-title {
  font-size: 16px;
  font-weight: 700;
  color: #FFFFFF;
}

.cropper-hint {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
  margin: 6px 24px 16px;
  text-align: center;
}

.crop-frame {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  background: #2B2625;
  box-shadow: 0 0 0 2px #F9E27A;
}

.crop-image {
  position: absolute;
  top: 0;
  left: 0;
  max-width: none;
  will-change: transform;
}

.crop-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 13px;
}

.grid-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.35);
  pointer-events: none;
}

.grid-v1, .grid-v2 {
  top: 0;
  bottom: 0;
  width: 1px;
}

.grid-h1, .grid-h2 {
  left: 0;
  right: 0;
  height: 1px;
}

.grid-v1 { left: 33.33%; }
.grid-v2 { left: 66.66%; }
.grid-h1 { top: 33.33%; }
.grid-h2 { top: 66.66%; }

.zoom-row {
  display: flex;
  align-items: center;
  margin-top: 16px;
}

.zoom-slider {
  flex: 1;
  margin: 0 8px;
}

.zoom-icon {
  color: #FFFFFF;
  font-size: 16px;
}

.cropper-actions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.crop-btn {
  flex: 1;
  height: 42px;
  padding: 0;
  font-size: 14px;
}

.crop-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}
