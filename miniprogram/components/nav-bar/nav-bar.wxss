.nav-bar-container {
  width: 100%;
  height: 56px;
  background-color: #FBEAF0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
}

.nav-left, .nav-right {
  width: 80px;
  display: flex;
  align-items: center;
}

.nav-right {
  justify-content: flex-end;
}

.my-nomination-btn, .back-btn {
  background: #FFFFFF;
  border-radius: 14px;
  padding: 5px 10px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.my-nomination-btn .icon {
  font-size: 11px;
  margin-right: 4px;
}

.my-nomination-btn .text, .back-btn .text {
  font-size: 11px;
  font-weight: 500;
  color: #4A3E3D;
}

.back-btn .back-arrow {
  font-size: 16px;
  line-height: 1;
  margin-right: 2px;
  color: #4A3E3D;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.main-title {
  font-size: 14px;
  font-weight: 600;
  color: #38242A;
  line-height: 1.2;
}

.sub-title {
  font-size: 11px;
  font-weight: 500;
  color: #993C1D;
  margin-top: 2px;
  line-height: 1.2;
}

/* 宫师姐规则气泡按钮：圆角 16px 16px 16px 4px，左下角尖角指向内容区 */
.rules-bubble-btn {
  width: 34px;
  height: 30px;
  background-color: #FFFFFF;
  border-radius: 16px 16px 16px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}

.avatar-ring {
  width: 24px;
  height: 24px;
  background-color: #F4C0D1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 11px;
  font-weight: bold;
  color: #612D3A;
}
