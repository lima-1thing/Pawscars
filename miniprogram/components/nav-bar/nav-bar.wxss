.nav-bar-container {
  width: 100%;
  background-color: #FBEAF0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
}

.nav-bar-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  box-sizing: border-box;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
  gap: 6px;
  position: relative;
  z-index: 1;
}

.nav-right {
  justify-content: flex-end;
}

.icon-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.icon-btn-text {
  font-size: 18px;
  line-height: 1;
  color: #4A3E3D;
}

.my-nomination-btn {
  background: #FFFFFF;
  border-radius: 14px;
  padding: 5px 10px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.my-nomination-btn .icon {
  font-size: 11px;
  margin-right: 4px;
}

.my-nomination-btn .text {
  font-size: 11px;
  font-weight: 500;
  color: #4A3E3D;
}

.nav-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.main-title {
  max-width: 44%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 14px;
  font-weight: 600;
  color: #38242A;
  line-height: 1.2;
}

.sub-title {
  font-size: 11px;
  font-weight: 500;
  color: #993C1D;
  margin-top: 2px;
  line-height: 1.2;
}

/* 宫师姐规则气泡按钮：圆角 16px 16px 16px 4px，左下角尖角指向内容区 */
.rules-bubble-btn {
  width: 34px;
  height: 30px;
  background-color: #FFFFFF;
  border-radius: 16px 16px 16px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}

.avatar-ring {
  width: 24px;
  height: 24px;
  background-color: #F4C0D1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 11px;
  font-weight: bold;
  color: #612D3A;
}

.avatar-ring {
  overflow: hidden;
}

.avatar-img {
  width: 24px;
  height: 24px;
}
