<view class="nav-bar-container" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar-inner" style="height: {{navHeight}}px; padding-right: {{capsuleInset}}px;">
    <!-- 左侧：返回/首页 + 我的提名入口 -->
    <view class="nav-left">
      <view class="icon-btn" bindtap="onTapBack" aria-role="button" aria-label="{{canGoBack ? '返回' : '回到首页'}}">
        <text class="icon-btn-text">{{canGoBack ? '‹' : '⌂'}}</text>
      </view>
      <view wx:if="{{showMyNomination}}" class="my-nomination-btn" bindtap="onTapMyNomination">
        <text class="icon">📋</text>
        <text class="text">我的提名</text>
      </view>
    </view>

    <!-- 中间：两行标题（绝对居中，不受左右按钮宽度影响） -->
    <view class="nav-center">
      <view class="main-title">{{title || 'Pawscars毛孩奥斯卡'}}</view>
      <view wx:if="{{subtitle}}" class="sub-title">{{subtitle}}</view>
    </view>

    <!-- 右侧：比赛规则气泡按钮（位于胶囊按钮左侧） -->
    <view class="nav-right">
      <view wx:if="{{showRules}}" class="rules-bubble-btn" bindtap="onTapRules" aria-role="button" aria-label="比赛规则">
        <view class="avatar-ring">
          <image wx:if="{{hostAvatar}}" class="avatar-img" src="{{hostAvatar}}" mode="aspectFill" binderror="onAvatarError" />
          <text wx:else class="avatar-text">{{hostInitial}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
